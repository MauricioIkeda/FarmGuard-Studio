# Repositorio consumido em modo leitura pelo Studio.
FARMGUARD_ROOT=C:\Users\PczinhoLindo\Documents\GitHub\FarmGuard

# Libera operacoes que criam runs, predictions e DatasetYolo no FarmGuard.
ALLOW_FARMGUARD_JOBS=false

# Autenticacao obrigatoria para acesso local/remoto.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=gere-uma-chave-aleatoria-longa

# Google Drive via rclone. Em branco, o Studio tenta reutilizar a configuracao
# do NTE Localization Studio automaticamente.
INSECT_AI_RCLONE_PATH=
INSECT_AI_RCLONE_CONFIG=
INSECT_AI_DRIVE_REMOTE=nte-google-drive
INSECT_AI_DRIVE_ROOT=Insect AI Datasets

# Opcional: token de um Cloudflare Tunnel nomeado. Nunca versione o .env.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=

PORT=4310
